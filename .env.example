# ── Twilio (WhatsApp) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox sender for testing: whatsapp:+14155238886
# Production: your verified WhatsApp-enabled Twilio number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# E.164 format recipient, e.g. +919999999999
TWILIO_WHATSAPP_TO=+91xxxxxxxxxx

# ── ElevenLabs (AI voice) ─────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=freelancer

# ── Stripe ───────────────────────────────────────────────────────────────────
# Use sk_test_... (test) or sk_live_... (production) secret key.
# Restricted keys (rk_...) also work but need Checkout Sessions + PaymentIntents write permissions.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret — get from Stripe Dashboard -> Developers -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Documenso (e-signatures) ──────────────────────────────────────────────────
DOCUMENSO_API_KEY=your_documenso_api_key_here
# Leave blank to use the hosted Documenso cloud
# DOCUMENSO_BASE_URL=https://app.documenso.com

# ── Lead sourcing APIs (optional -- falls back to demo data without them) ──────
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# ISO 3166-1 alpha-2 country code, e.g. gb, us, au
ADZUNA_COUNTRY=gb
JOOBLE_API_KEY=your_jooble_api_key

# ── App URL (required in production for Stripe redirect URLs) ─────────────────
# Set to your Vercel deployment URL, e.g. https://yourapp.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
